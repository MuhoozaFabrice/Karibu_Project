# Database Configuration
# For local development, use: mongodb://127.0.0.1:27017/kgl_db
# For MongoDB Atlas, use: mongodb+srv://username:password@cluster.mongodb.net/kgl_db
MONGO_URI=mongodb://127.0.0.1:27017/kgl_db

# JWT Secret - Change this to a secure random string in production
# IMPORTANT: Use a strong, random string in production
JWT_SECRET=change_this_to_a_secure_secret

# Server Port
PORT=5000
